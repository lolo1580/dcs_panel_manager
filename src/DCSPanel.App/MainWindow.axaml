<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DCSPanel.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="DCSPanel.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DCS Panel Manager"
        Width="1200" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="64,*">
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#243047" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#2563EB">
                        <TextBlock Text="DP" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="DCS Panel Manager" FontWeight="SemiBold" FontSize="17" />
                        <TextBlock Text="Hardware bridge - Milestone 1" Classes="muted" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Background="#1E293B" CornerRadius="20" Padding="12,6">
                    <TextBlock Text="DCS offline" Foreground="#FCA5A5" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" TabStripPlacement="Left" Background="Transparent">
            <TabItem Header="Dashboard">
                <ScrollViewer>
                    <StackPanel Margin="32" Spacing="22">
                        <StackPanel>
                            <TextBlock Text="Dashboard" Classes="heading" />
                            <TextBlock Text="DCS World and connected panel status" Classes="muted" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="DCS World" Classes="muted" />
                                    <TextBlock Text="{Binding DcsWorldStatus}" FontSize="21" FontWeight="SemiBold" Foreground="#FCA5A5" />
                                    <TextBlock Text="Detected aircraft" Classes="muted" FontSize="12" />
                                    <TextBlock Text="{Binding DetectedAircraft}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="DCS-BIOS" Classes="muted" />
                                    <TextBlock Text="{Binding DcsBiosStatus}" FontSize="21" FontWeight="SemiBold" Foreground="#FCA5A5" />
                                    <TextBlock Text="No socket is opened in this milestone" Classes="muted" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Devices" Classes="muted" />
                                    <TextBlock Text="{Binding DeviceSummary}" FontSize="21" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Devices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DeviceViewModel">
                                                <TextBlock Text="{Binding Model}" Margin="0,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Active Profile" Classes="muted" />
                                    <TextBlock Text="{Binding ActiveProfile}" FontSize="21" FontWeight="SemiBold" />
                                    <TextBlock Text="Safe default: NoSync" Classes="muted" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Devices">
                <ScrollViewer>
                    <StackPanel Margin="32" Spacing="18">
                        <StackPanel>
                            <TextBlock Text="Devices" Classes="heading" />
                            <TextBlock Text="Detected compatible Logitech/Saitek HID panels" Classes="muted" />
                        </StackPanel>
                        <Border IsVisible="{Binding HasNoDevices}" Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="No PZ55/PZ70 detected" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Connect a panel; this list refreshes automatically." Classes="muted" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceViewModel">
                                    <Border Classes="card" Margin="0,0,0,12">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="5">
                                            <TextBlock Text="{Binding Model}" FontWeight="SemiBold" FontSize="17" />
                                            <Border Grid.Column="1" Background="#123B2B" CornerRadius="12" Padding="10,4">
                                                <TextBlock Text="{Binding State}" Foreground="#86EFAC" FontSize="12" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding VidPid}" Foreground="#93C5FD" />
                                            <TextBlock Grid.Row="2" Text="{Binding InstancePath}" Classes="muted" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="20">
                                                <TextBlock Text="{Binding SerialNumber, StringFormat='Serial: {0}'}" Classes="muted" FontSize="12" />
                                                <TextBlock Text="{Binding ConnectedAt, StringFormat='Connected: {0}'}" Classes="muted" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Profiles"><TextBlock Margin="32" Text="Profiles - editor planned for a future milestone" Classes="heading" /></TabItem>
            <TabItem Header="Mappings"><TextBlock Margin="32" Text="Mappings - engine ready, editor coming later" Classes="heading" /></TabItem>
            <TabItem Header="DCS-BIOS"><TextBlock Margin="32" Text="DCS-BIOS - transport disabled in milestone 1" Classes="heading" /></TabItem>

            <TabItem Header="Live Monitor">
                <Grid Margin="32" RowDefinitions="Auto,Auto,*" RowSpacing="14">
                    <StackPanel>
                        <TextBlock Text="Live Monitor" Classes="heading" />
                        <TextBlock Text="Raw HID reports, decoded controls, and errors" Classes="muted" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="18">
                        <CheckBox Content="Hardware" IsChecked="{Binding ShowHardware}" />
                        <CheckBox Content="Mapping" IsChecked="{Binding ShowMapping}" />
                        <CheckBox Content="DCS-BIOS" IsChecked="{Binding ShowDcsBios}" />
                        <CheckBox Content="Error" IsChecked="{Binding ShowErrors}" />
                    </StackPanel>
                    <Border Grid.Row="2" Classes="card" Padding="0">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Activities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActivityEventViewModel">
                                        <Grid ColumnDefinitions="90,100,130,*" Margin="14,9" ColumnSpacing="12">
                                            <TextBlock Text="{Binding Time}" Classes="muted" FontFamily="Consolas" />
                                            <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#60A5FA" />
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" FontFamily="Consolas" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Settings"><TextBlock Margin="32" Text="Settings - options coming later" Classes="heading" /></TabItem>
        </TabControl>
    </Grid>
</Window>
