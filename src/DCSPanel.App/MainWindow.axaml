<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DCSPanel.App.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="800"
        x:Class="DCSPanel.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DCS Panel Manager"
        Width="1280"
        Height="800"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="64,*">
        <Border Grid.Row="0"
                Background="#0B1321"
                BorderBrush="#1B293D"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#1D4ED8">
                        <TextBlock Text="DP" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="DCS Panel Manager" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="DCS-BIOS PANEL INTEGRATION" Classes="eyebrow" FontSize="9" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9">
                    <Border Classes="chip">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="7" Height="7" Fill="{Binding DcsBiosStatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="DCS-BIOS" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DcsBiosStatus}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Classes="chip">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="7" Height="7" Fill="#60A5FA" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DeviceSummary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" TabStripPlacement="Left">
            <TabItem>
                <TabItem.Header>
                    <Grid ColumnDefinitions="34,*">
                        <Border Width="25" Height="25" CornerRadius="7" Background="#1E3150" VerticalAlignment="Center">
                            <TextBlock Text="▦" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center" />
                    </Grid>
                </TabItem.Header>
                <Border Background="#070C16">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="34,30" Spacing="22" MaxWidth="1180" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Overview" Classes="pageTitle" />
                                    <TextBlock Text="DCS World, DCS-BIOS, connected panels and active profile" Classes="muted" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CommandTransmissionStatus}" Foreground="#93C5FD" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border CornerRadius="12" Padding="22,20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#15243B" Offset="0" />
                                        <GradientStop Color="#101A2A" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="PANEL INTEGRATION" Classes="eyebrow" Foreground="#8FB9FF" />
                                        <TextBlock Text="Operational status" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Text="Use the active profile to send commands from the PZ55 and PZ70. Command transmission remains disabled until explicitly enabled in Settings."
                                                   Classes="muted" MaxWidth="660" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="52" Height="52" CornerRadius="10" Background="#163353" VerticalAlignment="Center">
                                        <TextBlock Text="DCS" Foreground="#93C5FD" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="DCS WORLD" Classes="eyebrow" />
                                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding DcsWorldStatusBrush}" />
                                        </Grid>
                                        <TextBlock Text="{Binding DcsWorldStatus}" Classes="statusValue" />
                                        <TextBlock Text="{Binding DetectedAircraft, StringFormat='Aircraft: {0}'}" Classes="muted" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="card">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="DCS-BIOS" Classes="eyebrow" />
                                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding DcsBiosStatusBrush}" />
                                        </Grid>
                                        <TextBlock Text="{Binding DcsBiosStatus}" Classes="statusValue" />
                                        <TextBlock Text="{Binding DcsBiosPacketCount, StringFormat='Packets: {0}'}" Classes="muted" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="DEVICES" Classes="eyebrow" />
                                        <TextBlock Text="{Binding Devices.Count}" Classes="statusValue" />
                                        <TextBlock Text="Compatible panels online" Classes="muted" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="ACTIVE PROFILE" Classes="eyebrow" />
                                        <TextBlock Text="{Binding ActiveProfile}" Classes="statusValue" />
                                        <TextBlock Text="Safe strategy: NoSync" Classes="muted" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="1.35*,*" ColumnSpacing="14">
                                <Border Classes="card">
                                    <StackPanel Spacing="15">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock Text="Connected hardware" Classes="sectionTitle" />
                                                <TextBlock Text="Logitech / Saitek flight panels" Classes="muted" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="LIVE" Foreground="#34D399" FontSize="10" FontWeight="Bold" LetterSpacing="1" />
                                        </Grid>
                                        <TextBlock IsVisible="{Binding HasNoDevices}" Text="No compatible panel detected" Classes="muted" Margin="0,8" />
                                        <ItemsControl ItemsSource="{Binding Devices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DeviceViewModel">
                                                    <Border Classes="subtleCard" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                            <Border Width="32" Height="32" CornerRadius="8" Background="#18304B">
                                                                <TextBlock Text="P" Foreground="#93C5FD" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Model}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding VidPid}" Classes="muted" FontSize="11" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                                <Ellipse Width="7" Height="7" Fill="#34D399" />
                                                                <TextBlock Text="{Binding State}" FontSize="11" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="card">
                                    <StackPanel Spacing="15">
                                        <TextBlock Text="DCS-BIOS activity" Classes="sectionTitle" />
                                        <Border Classes="subtleCard">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="LAST DATA" Classes="eyebrow" />
                                                <TextBlock Text="{Binding LastDcsBiosData}" Classes="mono" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="subtleCard">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="METADATA" Classes="eyebrow" />
                                                <TextBlock Text="{Binding MetadataStatus}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Grid ColumnDefinitions="34,*"><Border Width="25" Height="25" CornerRadius="7" Background="#173B38"><TextBlock Text="◉" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border><TextBlock Grid.Column="1" Text="Outputs" VerticalAlignment="Center" /></Grid>
                </TabItem.Header>
                <Border Background="#070C16">
                    <Grid Margin="34,30" RowDefinitions="Auto,Auto,*" RowSpacing="18">
                        <StackPanel Spacing="4"><TextBlock Text="Panel outputs" Classes="pageTitle" /><TextBlock Text="Connect DCS-BIOS data to PZ55 LEDs and PZ70 displays or autopilot LEDs for the active aircraft profile." Classes="muted" TextWrapping="Wrap" /></StackPanel>
                        <Border Grid.Row="1" Classes="card">
                            <Grid ColumnDefinitions="1.4*,1.2*,0.8*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="6"><TextBlock Text="DCS-BIOS VALUE" Classes="eyebrow" /><ComboBox ItemsSource="{Binding OutputControls}" SelectedItem="{Binding SelectedOutputControl}" PlaceholderText="Select a data value"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:DcsBiosControlViewModel"><TextBlock Text="{Binding Identifier}" Classes="mono" FontSize="11" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="PANEL TARGET" Classes="eyebrow" /><ComboBox ItemsSource="{Binding OutputTargets}" SelectedItem="{Binding SelectedOutputTarget}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:OutputTargetOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="PZ55 COLOR" Classes="eyebrow" /><ComboBox ItemsSource="{Binding OutputColors}" SelectedItem="{Binding SelectedOutputColor}" /></StackPanel>
                                <Button Grid.Column="3" Content="Add output" Command="{Binding AddOutputBindingCommand}" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Classes="card" Padding="0"><Grid RowDefinitions="44,*"><Border Padding="16,0" BorderBrush="#1E2B40" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Saved output bindings" Classes="sectionTitle" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Remove selected" Command="{Binding RemoveOutputBindingCommand}" Margin="0,5" /></Grid></Border><StackPanel Grid.Row="1" IsVisible="{Binding HasNoOutputBindings}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock Text="No output binding in this profile" Classes="sectionTitle" /><TextBlock Text="Start a DCS mission, then select a value and a panel target above." Classes="muted" /></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding OutputBindings}" SelectedItem="{Binding SelectedOutputBinding}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:OutputBindingViewModel"><Border BorderBrush="#152136" BorderThickness="0,0,0,1" Padding="16,11"><Grid ColumnDefinitions="150,180,*,100" ColumnSpacing="12"><TextBlock Text="{Binding DeviceType}" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding Target}" /><TextBlock Grid.Column="2" Text="{Binding ControlId}" Classes="mono" /><TextBlock Grid.Column="3" Text="{Binding Color}" Foreground="#6EE7B7" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Grid ColumnDefinitions="34,*">
                        <Border Width="25" Height="25" CornerRadius="7" Background="#193148"><TextBlock Text="⌘" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" /></Border>
                        <TextBlock Grid.Column="1" Text="Devices" VerticalAlignment="Center" />
                    </Grid>
                </TabItem.Header>
                <Border Background="#070C16">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="34,30" Spacing="22">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Devices" Classes="pageTitle" />
                                <TextBlock Text="Compatible Logitech/Saitek HID panels detected in real time" Classes="muted" />
                            </StackPanel>
                            <Border IsVisible="{Binding HasNoDevices}" Classes="card">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="#272338">
                                        <TextBlock Text="!" Foreground="#C4B5FD" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="No PZ55 or PZ70 detected" Classes="sectionTitle" />
                                        <TextBlock Text="Connect a panel and it will appear here automatically." Classes="muted" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeviceViewModel">
                                        <Border Classes="card" Margin="0,0,0,12">
                                            <Grid ColumnDefinitions="54,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                                                <Border Grid.RowSpan="3" Width="46" Height="46" CornerRadius="12" Background="#17334E" VerticalAlignment="Top">
                                                    <TextBlock Text="P" Foreground="#7DD3FC" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Model}" FontWeight="SemiBold" FontSize="18" />
                                                <Border Grid.Column="2" Classes="chip" Padding="10,4">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Ellipse Width="7" Height="7" Fill="#34D399" />
                                                        <TextBlock Text="{Binding State}" Foreground="#A7F3D0" FontSize="11" />
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="20">
                                                    <TextBlock Text="{Binding VidPid}" Foreground="#7DD3FC" FontSize="12" />
                                                    <TextBlock Text="{Binding SerialNumber, StringFormat='Serial: {0}'}" Classes="muted" FontSize="12" />
                                                    <TextBlock Text="{Binding ConnectedAt, StringFormat='Connected: {0}'}" Classes="muted" FontSize="12" />
                                                </StackPanel>
                                                <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="subtleCard" Padding="11,8">
                                                    <TextBlock Text="{Binding InstancePath}" Classes="muted mono" FontSize="10" TextWrapping="Wrap" />
                                                </Border>
                                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" IsVisible="{Binding SupportsOutputTest}">
                                                    <Button Content="{Binding OutputTestLabel}" Command="{Binding TestOutputCommand}" />
                                                    <TextBlock Text="Sends a visible hardware-only test; no command is sent to DCS World." Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Grid ColumnDefinitions="34,*"><Border Width="25" Height="25" CornerRadius="7" Background="#302647"><TextBlock Text="F" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" /></Border><TextBlock Grid.Column="1" Text="Profiles" VerticalAlignment="Center" /></Grid>
                </TabItem.Header>
                <Border Background="#070C16">
                    <Grid Margin="34,30" RowDefinitions="Auto,*" RowSpacing="22">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4"><TextBlock Text="Profiles" Classes="pageTitle" /><TextBlock Text="{Binding Profiles.Count, StringFormat='Aircraft and helicopter profiles from DCS-BIOS · {0} available'}" Classes="muted" /></StackPanel>
                            <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center"><TextBlock Text="{Binding ProfileDirectory}" Classes="mono muted" FontSize="10" /></Border>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="1.2*,*" ColumnSpacing="14">
                            <Border Classes="card" Padding="12">
                                <Grid>
                                    <TextBlock IsVisible="{Binding HasNoProfiles}" Text="No valid profile found" Classes="muted" Margin="12" />
                                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProfileViewModel">
                                                <Border Classes="subtleCard" Margin="0,0,0,8" MinHeight="76">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                                                        <Border Width="40" Height="40" CornerRadius="11" Background="#2E2545" VerticalAlignment="Center"><TextBlock Text="P" Foreground="#C4B5FD" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding Aircraft}" Classes="muted" FontSize="11" /><TextBlock Text="{Binding DevicesSummary}" Classes="muted" FontSize="11" /></StackPanel>
                                                        <Border Grid.Column="2" Classes="chip" Padding="9,4" VerticalAlignment="Center"><TextBlock Text="{Binding SafetyLabel}" Foreground="#6EE7B7" FontSize="10" /></Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Classes="card">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="ACTIVE PROFILE" Classes="eyebrow" />
                                    <TextBlock Text="{Binding SelectedProfile.DisplayName}" Classes="statusValue" />
                                    <Border Classes="subtleCard"><StackPanel Spacing="5"><TextBlock Text="AIRCRAFT" Classes="eyebrow" /><TextBlock Text="{Binding SelectedProfile.Aircraft}" /></StackPanel></Border>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Border Classes="subtleCard"><StackPanel Spacing="5"><TextBlock Text="DEVICES" Classes="eyebrow" /><TextBlock Text="{Binding SelectedProfile.DeviceCount}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                        <Border Grid.Column="1" Classes="subtleCard"><StackPanel Spacing="5"><TextBlock Text="MAPPINGS" Classes="eyebrow" /><TextBlock Text="{Binding SelectedProfile.MappingCount}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                    </Grid>
                                    <Border Classes="subtleCard"><StackPanel Spacing="5"><TextBlock Text="SWITCH SYNCHRONIZATION" Classes="eyebrow" /><TextBlock Text="{Binding SelectedProfile.SyncStrategy}" Foreground="#6EE7B7" /></StackPanel></Border>
                                    <TextBlock Text="Selecting a profile never transmits physical switch positions automatically." Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Grid ColumnDefinitions="34,*"><Border Width="25" Height="25" CornerRadius="7" Background="#253349"><TextBlock Text="M" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" /></Border><TextBlock Grid.Column="1" Text="Mappings" VerticalAlignment="Center" /></Grid>
                </TabItem.Header>
                <Border Background="#070C16">
                    <Grid Margin="34,30" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="18">
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Mappings" Classes="pageTitle" /><TextBlock Text="Physical controls and simulator actions from the active profile" Classes="muted" /></StackPanel><Border Grid.Column="1" Classes="chip" VerticalAlignment="Center"><TextBlock Text="{Binding ActiveProfile}" FontWeight="SemiBold" /></Border></Grid>
                        <Border Grid.Row="1" Classes="card" Padding="15,11">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Mapping editor" Classes="sectionTitle" />
                                        <TextBlock Text="Learn a panel input, choose a DCS-BIOS command, then save it to this aircraft profile." Classes="muted" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding EditorStatus}" Foreground="#7DD3FC" FontSize="11" TextWrapping="Wrap" MaxWidth="430" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="1.05*,1.45*,1.1*" ColumnSpacing="12">
                                    <Border Classes="subtleCard">
                                        <StackPanel Spacing="9">
                                            <TextBlock Text="1 · PHYSICAL INPUT" Classes="eyebrow" />
                                            <TextBlock Text="{Binding LearnedDeviceType}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LearnedControlId}" Classes="mono muted" FontSize="11" TextWrapping="Wrap" />
                                            <Button Content="{Binding LearnInputLabel}" Command="{Binding LearnInputCommand}" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="subtleCard">
                                        <StackPanel Spacing="9">
                                            <TextBlock Text="2 · DCS-BIOS COMMAND" Classes="eyebrow" />
                                            <TextBox Text="{Binding MappingCommandSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="Search a command..." />
                                            <ComboBox ItemsSource="{Binding WritableControls}"
                                                      SelectedItem="{Binding SelectedCommandControl}"
                                                      PlaceholderText="Select an available command">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DcsBiosControlViewModel">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Identifier}" Classes="mono" FontSize="11" />
                                                            <TextBlock Text="{Binding Category}" Classes="muted" FontSize="10" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="Only commands that accept input are listed." Classes="muted" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="subtleCard">
                                        <StackPanel Spacing="9">
                                            <TextBlock Text="3 · TRIGGER AND ARGUMENT" Classes="eyebrow" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <ComboBox ItemsSource="{Binding TriggerOptions}" SelectedItem="{Binding SelectedTriggerOption}" PlaceholderText="Trigger">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MappingTriggerOption">
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBox Grid.Column="1" Text="{Binding MappingArgument, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Value" />
                                            </Grid>
                                            <TextBlock Text="Suggested values can be changed before saving." Classes="muted" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9">
                                    <Button Content="Safe test" Command="{Binding TestMappingCommand}" />
                                    <Button Content="Add mapping" Command="{Binding AddMappingCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Classes="card" Padding="15,11">
                            <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="12">
                                <TextBlock Text="Physical input" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="→" Classes="muted" />
                                <TextBlock Grid.Column="2" Text="Profile mapping" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="→" Classes="muted" />
                                <TextBlock Grid.Column="4" Text="Backend action" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Classes="card" Padding="0" ClipToBounds="True">
                            <Grid RowDefinitions="44,40,*">
                                <Border Padding="16,0" BorderBrush="#1E2B40" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Saved mappings" Classes="sectionTitle" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Remove selected" Command="{Binding RemoveMappingCommand}" Margin="0,5" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="#0C1422" BorderBrush="#1E2B40" BorderThickness="0,0,0,1" Padding="16,0">
                                    <Grid ColumnDefinitions="115,135,105,115,90,*,95" ColumnSpacing="10">
                                        <TextBlock Text="DEVICE" Classes="eyebrow" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="CONTROL" Classes="eyebrow" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="INPUT" Classes="eyebrow" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="TRIGGER" Classes="eyebrow" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="BACKEND" Classes="eyebrow" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="COMMAND" Classes="eyebrow" VerticalAlignment="Center" /><TextBlock Grid.Column="6" Text="ARGUMENT" Classes="eyebrow" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2">
                                    <StackPanel IsVisible="{Binding HasNoMappings}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><Border Width="48" Height="48" CornerRadius="24" Background="#18243A"><TextBlock Text="0" Foreground="#8290A5" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="No mappings in this profile" Classes="sectionTitle" HorizontalAlignment="Center" /><TextBlock Text="The safe Generic profile intentionally starts empty." Classes="muted" /></StackPanel>
                                    <ListBox ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MappingViewModel">
                                                    <Border BorderBrush="#152136" BorderThickness="0,0,0,1" Padding="16,11">
                                                        <Grid ColumnDefinitions="115,135,105,115,90,*,95" ColumnSpacing="10"><TextBlock Text="{Binding DeviceType}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding ControlId}" Classes="mono" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding InputKind}" FontSize="11" /><TextBlock Grid.Column="3" Text="{Binding Trigger}" FontSize="11" /><TextBlock Grid.Column="4" Text="{Binding Backend}" Foreground="#7DD3FC" FontSize="11" /><TextBlock Grid.Column="5" Text="{Binding Command}" Classes="mono" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="6" Text="{Binding Argument}" Classes="mono muted" FontSize="11" /></Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Grid ColumnDefinitions="34,*"><Border Width="25" Height="25" CornerRadius="7" Background="#173B38"><TextBlock Text="B" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" /></Border><TextBlock Grid.Column="1" Text="DCS-BIOS" VerticalAlignment="Center" /></Grid>
                </TabItem.Header>
                <Border Background="#070C16">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="34,30" Spacing="22">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4"><TextBlock Text="DCS-BIOS" Classes="pageTitle" /><TextBlock Text="Read-only export stream and control metadata discovery" Classes="muted" /></StackPanel>
                                <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center"><TextBlock Text="TRANSMISSION DISABLED" Foreground="#6EE7B7" FontSize="10" FontWeight="Bold" LetterSpacing="1" /></Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <Border Classes="card">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Export stream" Classes="sectionTitle" /><Ellipse Grid.Column="1" Width="9" Height="9" Fill="{Binding DcsBiosStatusBrush}" /></Grid>
                                        <TextBlock Text="{Binding DcsBiosStatus}" Classes="statusValue" />
                                        <Border Classes="subtleCard"><StackPanel Spacing="5"><TextBlock Text="MULTICAST ENDPOINT" Classes="eyebrow" /><TextBlock Text="{Binding DcsBiosEndpoint}" Classes="mono" Foreground="#7DD3FC" /></StackPanel></Border>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Border Classes="subtleCard"><StackPanel Spacing="4"><TextBlock Text="PACKETS" Classes="eyebrow" /><TextBlock Text="{Binding DcsBiosPacketCount}" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                            <Border Grid.Column="1" Classes="subtleCard"><StackPanel Spacing="4"><TextBlock Text="LAST RECEIVE" Classes="eyebrow" /><TextBlock Text="{Binding LastDcsBiosData}" Classes="mono muted" FontSize="11" TextWrapping="Wrap" /></StackPanel></Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="card">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Control metadata" Classes="sectionTitle" />
                                        <TextBlock Text="{Binding MetadataStatus}" Classes="statusValue" FontSize="20" TextWrapping="Wrap" />
                                        <Border Classes="subtleCard"><StackPanel Spacing="5"><TextBlock Text="DISCOVERY PATH" Classes="eyebrow" /><TextBlock Text="{Binding MetadataDirectory}" Classes="mono muted" FontSize="11" TextWrapping="Wrap" /></StackPanel></Border>
                                        <TextBlock Text="Aircraft aliases select the CommonData and aircraft modules automatically. No aircraft command is hard-coded in the application." Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Classes="card" Padding="0" ClipToBounds="True" MinHeight="360">
                                <Grid RowDefinitions="Auto,40,320">
                                    <Border Padding="18,15" BorderBrush="#1E2B40" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Available controls" Classes="sectionTitle" />
                                                <TextBlock Text="Commands exposed by DCS-BIOS for the detected aircraft" Classes="muted" FontSize="12" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="AIRCRAFT" Classes="eyebrow" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ControlCatalogAircraft}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <TextBox Grid.Column="2"
                                                     Width="290"
                                                     Text="{Binding ControlSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="Search identifier, category, description..."
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Background="#0C1422" BorderBrush="#1E2B40" BorderThickness="0,0,0,1" Padding="16,0">
                                        <Grid ColumnDefinitions="145,210,105,145,105,*" ColumnSpacing="12">
                                            <TextBlock Text="CATEGORY" Classes="eyebrow" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="IDENTIFIER" Classes="eyebrow" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="TYPE" Classes="eyebrow" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="INPUT" Classes="eyebrow" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="OUTPUT" Classes="eyebrow" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="DESCRIPTION" Classes="eyebrow" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="2">
                                        <StackPanel IsVisible="{Binding HasNoControls}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                                            <Border Width="46" Height="46" CornerRadius="23" Background="#18302E">
                                                <TextBlock Text="B" Foreground="#6EE7B7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="No controls to display" Classes="sectionTitle" HorizontalAlignment="Center" />
                                            <TextBlock Text="Start a DCS mission or clear the search field." Classes="muted" />
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding Controls}" Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DcsBiosControlViewModel">
                                                    <Border BorderBrush="#152136" BorderThickness="0,0,0,1" Padding="16,10">
                                                        <Grid ColumnDefinitions="145,210,105,145,105,*" ColumnSpacing="12">
                                                            <TextBlock Text="{Binding Category}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Identifier}" Classes="mono" Foreground="#7DD3FC" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ControlType}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="3" Text="{Binding InputSummary}" Foreground="#A7F3D0" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="4" Text="{Binding OutputSummary}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="5" Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12" Classes="chip">
                                            <TextBlock Text="{Binding ControlCountSummary}" Classes="muted" FontSize="10" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Grid ColumnDefinitions="34,*"><Border Width="25" Height="25" CornerRadius="7" Background="#3A2C24"><TextBlock Text="L" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" /></Border><TextBlock Grid.Column="1" Text="Live Monitor" VerticalAlignment="Center" /></Grid>
                </TabItem.Header>
                <Border Background="#070C16">
                    <Grid Margin="34,30" RowDefinitions="Auto,Auto,*" RowSpacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4"><TextBlock Text="Live Monitor" Classes="pageTitle" /><TextBlock Text="Hardware events, DCS-BIOS traffic, mapping activity, and errors" Classes="muted" /></StackPanel>
                            <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="#34D399" /><TextBlock Text="LIVE" Foreground="#A7F3D0" FontSize="10" FontWeight="Bold" LetterSpacing="1" /></StackPanel></Border>
                        </Grid>
                        <Border Grid.Row="1" Classes="card" Padding="16,11">
                            <StackPanel Orientation="Horizontal" Spacing="22">
                                <TextBlock Text="FILTERS" Classes="eyebrow" VerticalAlignment="Center" />
                                <CheckBox Classes="monitorFilter" Content="Hardware" IsChecked="{Binding ShowHardware}" />
                                <CheckBox Classes="monitorFilter" Content="Mapping" IsChecked="{Binding ShowMapping}" />
                                <CheckBox Classes="monitorFilter" Content="DCS-BIOS" IsChecked="{Binding ShowDcsBios}" />
                                <CheckBox Classes="monitorFilter" Content="Errors" IsChecked="{Binding ShowErrors}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
                            <Grid RowDefinitions="40,*">
                                <Border Background="#0C1422" BorderBrush="#1E2B40" BorderThickness="0,0,0,1" Padding="16,0">
                                    <Grid ColumnDefinitions="90,105,140,*" ColumnSpacing="12">
                                        <TextBlock Text="TIME" Classes="eyebrow" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="CATEGORY" Classes="eyebrow" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="SOURCE" Classes="eyebrow" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="EVENT" Classes="eyebrow" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1">
                                    <ItemsControl ItemsSource="{Binding Activities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ActivityEventViewModel">
                                                <Border BorderBrush="#152136" BorderThickness="0,0,0,1" Padding="16,10">
                                                    <Grid ColumnDefinitions="90,105,140,*" ColumnSpacing="12">
                                                        <TextBlock Text="{Binding Time}" Classes="muted mono" FontSize="11" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#7DD3FC" FontSize="12" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Message}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Grid ColumnDefinitions="34,*"><Border Width="25" Height="25" CornerRadius="7" Background="#253049"><TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" /></Border><TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" /></Grid>
                </TabItem.Header>
                <Border Background="#070C16">
                    <StackPanel Margin="34,30" Spacing="22">
                        <StackPanel Spacing="4"><TextBlock Text="Settings" Classes="pageTitle" /><TextBlock Text="Application, network, and device preferences" Classes="muted" /></StackPanel>
                        <Border Classes="card" MaxWidth="720" HorizontalAlignment="Left">
                            <StackPanel Spacing="14">
                                <TextBlock Text="CURRENT CONFIGURATION" Classes="eyebrow" />
                                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                    <TextBlock Text="DCS-BIOS endpoint" Classes="muted" /><TextBlock Grid.Column="1" Text="{Binding DcsBiosEndpoint}" Classes="mono" />
                                    <TextBlock Grid.Row="1" Text="Command mode" Classes="muted" /><StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><CheckBox Content="Enable DCS commands" IsChecked="{Binding IsCommandTransmissionEnabled}" /><TextBlock Text="{Binding CommandTransmissionStatus}" Foreground="#6EE7B7" FontSize="11" /><TextBlock Text="Only enable this while DCS World and DCS-BIOS are running. The setting resets to safe mode when the app restarts." Classes="muted" FontSize="10" TextWrapping="Wrap" /></StackPanel>
                                    <TextBlock Grid.Row="2" Text="Profile sync" Classes="muted" /><TextBlock Grid.Row="2" Grid.Column="1" Text="NoSync" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
