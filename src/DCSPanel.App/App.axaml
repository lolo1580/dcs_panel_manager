<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DCSPanel.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Background" Value="#0B0D0F" />
            <Setter Property="Foreground" Value="#F0F1EE" />
        </Style>

        <Style Selector="TabControl">
            <Setter Property="Background" Value="#101417" />
        </Style>
        <Style Selector="TabStrip">
            <Setter Property="Background" Value="#101417" />
            <Setter Property="Padding" Value="8,16,8,0" />
            <Setter Property="BorderBrush" Value="#292F34" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="MinWidth" Value="216" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9AA39F" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Background" Value="#1A2022" />
            <Setter Property="Foreground" Value="#F0F1EE" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#26302A" />
            <Setter Property="Foreground" Value="#F5F1E6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#171B1E" />
            <Setter Property="BorderBrush" Value="#30373B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="#566157" />
        </Style>
        <Style Selector="Border.subtleCard">
            <Setter Property="Background" Value="#101416" />
            <Setter Property="BorderBrush" Value="#2A3135" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#151A1B" />
            <Setter Property="BorderBrush" Value="#343B3E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="11,6" />
        </Style>

        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="-0.4" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.statusValue">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="#6F8099" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.8" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9AA39F" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style Selector="CheckBox.monitorFilter">
            <Setter Property="Foreground" Value="#AAB6C8" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#B98A2D" />
            <Setter Property="Foreground" Value="#15120C" />
            <Setter Property="BorderBrush" Value="#D5A846" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#D5A846" />
        </Style>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="Background" Value="#101416" />
            <Setter Property="BorderBrush" Value="#3A4244" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#30382D" />
        </Style>
    </Application.Styles>
</Application>
